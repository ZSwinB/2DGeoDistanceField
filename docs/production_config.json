{
  "schema": "2dgeodistancefield-portable-runner/1.0",
  "entry": "python -m accelerated",
  "geometry": "External official vector polygon JSON, coordinates transformed (x,255-y), in meters",
  "input_contract": "INPUTS.md",
  "selection": "External integer (N,2) NPY or scene,tx CSV; arbitrary selected city/TX count",
  "scale_options": {
    "1": {"shape": [256, 256], "spacing_m": 1.0},
    "10": {"shape": [2560, 2560], "spacing_m": 0.1}
  },
  "default_scale": 10,
  "K": 1,
  "DIFF_BIAS": 300.0,
  "FALLBACK_BIAS": 600.0,
  "building_and_max_value": 1000.0,
  "geometry_mirrors_comparisons_dtype": "float64",
  "output_dtype": "float32",
  "fastmath": false,
  "float16_export": false,
  "field_smoothing": false,
  "source_coordinates": "Validated official integer XY in [0,255], not moved; inside/boundary flags retained",
  "default_CPU_control_points_per_map": 128,
  "native_CPU_control_seed": "20261016+scene_id",
  "PVW_CPU_tile_rows": 16,
  "GPU_RX_threads_per_block": 128,
  "GPU_PVP_byte_threads_per_block": 128,
  "GPU_output_fill_threads_per_block": 256,
  "default_external_CPU_workers": 4,
  "historical_external_CPU_workers": [12, 16],
  "internal_thread_environment": {"OPENBLAS_NUM_THREADS": 1, "OMP_NUM_THREADS": 1, "NUMBA_NUM_THREADS": 1},
  "city_prefetch_depth": 1,
  "writer_threads": 1,
  "max_pending_map_writes": 3,
  "minimum_free_disk_bytes": 2147483648,
  "output_format": "DMAPLS01 lossless FP32",
  "chunk_shape": [256, 256],
  "predictor": "Reversible uint32 bit-pattern delta2d modulo 2^32",
  "codec": "Blosc BITSHUFFLE + Zstd level 3, one codec thread",
  "full_decode_byte_check_at_write": true,
  "per_map_fsync": false,
  "required_platform_for_simulation": "Linux/POSIX with working Numba CUDA environment",
  "no_inputs_outputs_or_weights_distributed": true
}
